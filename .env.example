# Copy this file to .env and replace the placeholder. Never commit or share .env.
OPENAI_API_KEY=replace-with-your-new-token
OPENAI_BASE_URL=http://ai-gateway.momo.com
GENERATION_MODEL=claude-sonnet-4.6
LLM_RERANK_MODEL=deepseek-v4-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
BGE_RERANK_URL=http://localhost:8081
BGE_RERANK_PATH=/rerank
BGE_RERANK_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=requirement_chunks
# GitLab webhook: configure Secret Token in GitLab; signature sent as X-Gitlab-Signature-256 (HMAC-SHA256 of raw body)
WEBHOOK_SECRET=replace-with-your-webhook-secret

# Default project (backward compatible, used when projects list is empty)
KNOWLEDGE_BOOTSTRAP_ENABLED=true
KNOWLEDGE_ZIP_PATH=产品文档.zip
KNOWLEDGE_XLSX_PATH=封神版本问题整理.xlsx
KNOWLEDGE_DOCUMENT_ID=fengshen
KNOWLEDGE_VERSION=5.1

# Multi-project example (uncomment to enable)
# PROJECT_1_ID=fengshen-server
# PROJECT_1_NAME=封神服务端
# PROJECT_1_GROUP=fengshen
# PROJECT_1_SIDE=server
# PROJECT_1_REQ_COLLECTION=fengshen_server_requirements
# PROJECT_1_CODE_COLLECTION=fengshen_server_code
# PROJECT_1_REPO_PATH=/data/repos/immortal-game-service
# PROJECT_1_GIT_PATH=game-team/immortal-game-service
# PROJECT_1_BOOTSTRAP=true
# PROJECT_1_ZIP_PATH=产品文档.zip
# PROJECT_1_DOC_ID=fengshen
# PROJECT_1_VERSION=5.1
# PROJECT_1_ZIP_PREFIX=5.1

# API Key Authentication (disabled by default)
# AUTH_ENABLED=true
# AUTH_USER_1_NAME=admin
# AUTH_USER_1_KEY=replace-with-your-api-key
# AUTH_USER_1_ROLE=SUPER_ADMIN
# AUTH_USER_2_NAME=developer
# AUTH_USER_2_KEY=replace-with-developer-key
# AUTH_USER_2_ROLE=DEVELOPER
# AUTH_USER_2_PROJECT=fengshen-server

# Observability
TRACING_SAMPLING_PROBABILITY=1.0
STRUCTURED_LOG_FORMAT=logstash
OTLP_TRACING_ENABLED=false
OTLP_METRICS_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
