# Copy this file to .env and replace the placeholder. Never commit or share .env.
OPENAI_API_KEY=replace-with-your-new-token
OPENAI_BASE_URL=https://api.example.com/v1
GITLAB_HEALTH_URL=https://gitlab.com
GITLAB_HEALTH_PATH=/explore
GENERATION_MODEL=your-generation-model
LLM_RERANK_MODEL=your-rerank-model
VISION_ENABLED=false
VISION_MODEL=glm-5.2
RETRIEVAL_DOCUMENT_PAGE_INDEX_ENABLED=false
VISION_MAX_IMAGES_PER_DOC=20
VISION_TIMEOUT_MS=8000
VISION_CONCURRENCY=3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
BGE_RERANK_URL=http://localhost:8081
BGE_RERANK_PATH=/rerank
BGE_RERANK_API_KEY=
BGE_RERANK_CONNECT_TIMEOUT_MS=2000
BGE_RERANK_READ_TIMEOUT_MS=10000
BGE_RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3
BGE_RERANK_DEVICE=auto
BGE_RERANK_BATCH_SIZE=4
BGE_RERANK_MAX_LENGTH=8192
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=requirement_chunks
CODE_QDRANT_COLLECTION=code_chunks_example_service
CODE_REPOSITORY_PATH=/absolute/path/to/your-repository
# GitLab webhook: configure Secret Token in GitLab; signature sent as X-Gitlab-Signature-256 (HMAC-SHA256 of raw body)
WEBHOOK_SECRET=replace-with-your-webhook-secret

# GitLab 项目自动接入（默认关闭）。密钥生成：openssl rand -base64 32
GITLAB_INTEGRATION_ENABLED=false
GITLAB_UI_ENABLED=true
GITLAB_REPOSITORY_ROOT_PATH=data/gitlab-repositories
GITLAB_DATABASE_PATH=data/gitlab-integration.db
GITLAB_ENCRYPTION_KEY=
GITLAB_GIT_TIMEOUT_SECONDS=120
GITLAB_SYNC_THREADS=2
GITLAB_ALLOWED_HOSTS=gitlab.com
GITLAB_ALLOW_PRIVATE_HOSTS=false

# Default project (backward compatible, used when projects list is empty)
KNOWLEDGE_BOOTSTRAP_ENABLED=true
KNOWLEDGE_ZIP_PATH=产品文档.zip
KNOWLEDGE_XLSX_PATH=requirements.xlsx
KNOWLEDGE_DOCUMENT_ID=example-requirements
KNOWLEDGE_VERSION=1.1.0

# Versioned Wiki and reviewable build drafts (JSON/Markdown only; never Qdrant storage)
WIKI_ROOT_PATH=data/wiki
WIKI_SOURCE_PATH=data/wiki-sources
WIKI_DRAFT_PATH=data/wiki-drafts
VERSION_MANIFEST_ROOT_PATH=data/version-manifests

# Multi-project example (uncomment to enable)
# PROJECT_1_ID=example-service
# PROJECT_1_NAME=Example Service
# PROJECT_1_GROUP=example
# PROJECT_1_SIDE=server
# PROJECT_1_REQ_COLLECTION=example_service_requirements
# PROJECT_1_CODE_COLLECTION=example_service_code
# PROJECT_1_REPO_PATH=/data/repos/example-service
# PROJECT_1_GIT_PATH=example-team/example-service
# PROJECT_1_BOOTSTRAP=true
# PROJECT_1_ZIP_PATH=产品文档.zip
# PROJECT_1_DOC_ID=example-requirements
# PROJECT_1_VERSION=1.1.0
# PROJECT_1_ZIP_PREFIX=1.1.0

# Observability
TRACING_SAMPLING_PROBABILITY=1.0
STRUCTURED_LOG_FORMAT=logstash
OTLP_TRACING_ENABLED=false
OTLP_METRICS_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
KNOWLEDGE_MANAGEMENT_ENABLED=true
KNOWLEDGE_MANAGEMENT_DATABASE_PATH=data/knowledge-management.db

# Requirement semantic graph MVP (disabled by default; does not replace Qdrant retrieval)
REQUIREMENT_GRAPH_ENABLED=false
REQUIREMENT_GRAPH_EXTRACTION_ENABLED=true
REQUIREMENT_GRAPH_RETRIEVAL_ENABLED=false
REQUIREMENT_GRAPH_DATABASE_PATH=data/requirement-graph.db
REQUIREMENT_GRAPH_EXTRACTION_MODEL=
REQUIREMENT_GRAPH_EXTRACTION_PROMPT_VERSION=v1
REQUIREMENT_GRAPH_ONTOLOGY_VERSION=v1
REQUIREMENT_GRAPH_SCHEMA_VERSION=2
REQUIREMENT_GRAPH_WINDOW_OVERLAP_CHARS=400
REQUIREMENT_GRAPH_MAX_WINDOWS=500
REQUIREMENT_GRAPH_MAX_MODEL_CALLS=500
REQUIREMENT_GRAPH_MAX_RETRIES=2
REQUIREMENT_GRAPH_MAX_WALL_CLOCK_SECONDS=900
REQUIREMENT_GRAPH_MAX_ESTIMATED_TOKENS=0
REQUIREMENT_GRAPH_MAX_CONCURRENT_WORKERS=2
REQUIREMENT_GRAPH_MAX_GRAPH_ROWS=10000
REQUIREMENT_GRAPH_ALLOW_PARTIAL_BUILD=false
REQUIREMENT_GRAPH_SHADOW_BUILD=false
REQUIREMENT_GRAPH_SHADOW_QUERY=false
REQUIREMENT_GRAPH_HYBRID_RETRIEVAL_ENABLED=false
REQUIREMENT_GRAPH_REQUIRE_PUBLISHED_FOR_SEARCH=true
REQUIREMENT_GRAPH_EXTERNAL_TRANSMISSION_ALLOWED=false
REQUIREMENT_GRAPH_DATA_CLASSIFICATION=INTERNAL
REQUIREMENT_GRAPH_ALLOWED_PROVIDER=configured
REQUIREMENT_GRAPH_PRIVACY_POLICY_REQUIRED=false
REQUIREMENT_GRAPH_FUSION_TEXT_WEIGHT=0.30
REQUIREMENT_GRAPH_FUSION_ENTITY_WEIGHT=0.20
REQUIREMENT_GRAPH_FUSION_RELATION_WEIGHT=0.15
REQUIREMENT_GRAPH_FUSION_PATH_WEIGHT=0.15
REQUIREMENT_GRAPH_FUSION_EVIDENCE_WEIGHT=0.15
REQUIREMENT_GRAPH_FUSION_FRESHNESS_WEIGHT=0.05
